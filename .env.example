# ============================================================================
# Frontend (Vite). Only variables prefixed with VITE_ reach the browser bundle.
# Everything in this section ends up in client-side JavaScript, so never put a
# secret here.
# ============================================================================
VITE_API_URL=
VITE_WHATSAPP_NUMBER=923233334492


# ============================================================================
# Backend. Set these in BOTH places:
#   1. server/.env          (local development)
#   2. Vercel project dashboard -> Settings -> Environment Variables
#      https://vercel.com/<project>/settings/environment-variables
#
# They are read from process.env by api/*.js (Vercel) and server/routes/*.js
# (local dev). Both stacks import the same logic from shared/, so behaviour
# matches as long as the values match.
# ============================================================================

# --- Database (required) -----------------------------------------------------
# IMPORTANT (Windows / MongoDB Dev Desktop): use the mongodb:// protocol with
# tls enabled. mongodb+srv:// fails on Windows and will not connect.
MONGODB_URI=

# --- Auth (required) ---------------------------------------------------------
# Generate strong random values, one per secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# At least 32 characters. In Vercel, mark these as SENSITIVE so they are
# encrypted at rest and hidden from the dashboard UI.
# Rotating either one invalidates every existing session.
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Image uploads (required for the admin CMS to upload images) -------------
# From the Cloudinary dashboard. CLOUDINARY_API_SECRET is a real secret:
# never prefix it with VITE_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google Places reviews (optional) ----------------------------------------
# Without these, /api/google-reviews returns 501 and the storefront simply shows
# no Google reviews. Restrict the key by HTTP referrer to your own domains.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# --- Scheduled publishing (required if you use the Vercel cron) --------------
# api/publish-scheduled.js refuses to run in production unless this is set, and
# then requires the same value in the x-cron-secret request header.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Local dev only ----------------------------------------------------------
# Port for the Express server (default 3001).
PORT=3001

# Seed script (npm run seed, from server/). REQUIRED — the script now refuses to
# run rather than fall back to a default password, which previously created an
# admin account with the password "changeme".
# At least 16 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_EMAIL_1=admin@honeybeelane.com
ADMIN_PASSWORD=
ADMIN_EMAIL_2=
ADMIN_PASSWORD_2=


# ============================================================================
# Keeping serverless functions warm
# ============================================================================
# Set up a free job at https://cron-job.org that pings
#   https://honeybeelane.vercel.app/api/health
# every 4 minutes. The Hobby plan idles out at ~5 min. api/health.js must exist
# for this to work — it was previously missing, so the documented ping 404'd.